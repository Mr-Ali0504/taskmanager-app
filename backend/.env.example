# =============================================================================
# Backend Environment Variables
# Reference: https://www.npmjs.com/package/dotenv
#
# HOW TO USE:
# 1. Copy this file: cp .env.example .env
# 2. Fill in the values for your environment
# 3. NEVER commit .env to Git — it contains secrets!
#    The .gitignore file should exclude .env
# =============================================================================

# Application environment — controls logging, error detail level, etc.
# Values: development | staging | production
NODE_ENV=development

# The port the backend server listens on
PORT=5000

# Application version — shown in the /api/health endpoint
# In a real CI/CD pipeline, Jenkins would inject this automatically
APP_VERSION=1.0.0

# MongoDB connection string
# Local dev (no Docker): mongodb://localhost:27017/taskmanager
# Docker Compose:        mongodb://mongo:27017/taskmanager  ('mongo' is the service name)
# MongoDB Atlas (cloud): mongodb+srv://<user>:<password>@cluster.mongodb.net/taskmanager
MONGO_URI=mongodb://mongo:27017/taskmanager

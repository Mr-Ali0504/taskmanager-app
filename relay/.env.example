# Copy to .env and fill in. Never commit .env.

# Password for the app itself. Required before putting this on the internet:
# without it, anyone who can open the page can publish to your channels.
APP_PASSWORD=

# The address you open the app at. OAuth redirect URLs are built from it.
#   npm run dev          -> http://localhost:5173
#   npm start / Docker   -> http://localhost:8787, or https://your-domain
PUBLIC_URL=http://localhost:5173

# YouTube (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application")
# Authorised redirect URI: <PUBLIC_URL>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram + Facebook (developers.facebook.com -> your app -> App settings -> Basic)
# Valid OAuth redirect URI: <PUBLIC_URL>/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
# Graph API version to call. Meta retires versions after about two years.
META_GRAPH_VERSION=v26.0

# Assistant (optional). An Anthropic API key from the Claude Console lets you tell the app what to post
# and have it draft comment replies. Usage is billed to your Anthropic account.
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5

# Optional
# PORT=8787
# DATA_DIR=./data          # database, uploaded videos and thumbnails
# MAX_UPLOAD_GB=8
# APP_SECRET=              # encrypts stored tokens; generated into DATA_DIR/secret.key if unset

# =============================================================================
# Frontend Environment Variables
# Reference: https://vitejs.dev/guide/env-and-mode.html
#
# HOW TO USE:
# 1. Copy this file: cp .env.example .env
# 2. Fill in values for your environment
# 3. VITE_ prefix is REQUIRED — Vite only exposes variables with this prefix to the browser
# 4. Access in code with: import.meta.env.VITE_API_URL
# =============================================================================

# The base URL of the backend API
# Development (via Vite proxy): leave empty — proxy handles it automatically
# Staging/Prod Docker:          set to the backend container/service URL
VITE_API_URL=

# The environment name displayed in the UI badge
VITE_APP_ENV=development
